{
  "name": "neonbreach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/manus-game-assets/restore.mjs && vite",
    "dev:server": "pnpm --dir server start",
    "build": "node scripts/manus-game-assets/restore.mjs && node scripts/manus-game-sharing/build.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "pnpm --dir server test",
    "smoke": "node scripts/smoke.mjs",
    "manus:build-source": "tsc --noEmit && vite build && node scripts/check-size.mjs",
    "native:setup": "node scripts/setup-native-packaging.mjs",
    "native:check": "node scripts/setup-native-packaging.mjs --check",
    "build:native": "pnpm build && node scripts/setup-native-packaging.mjs --check",
    "desktop:dev": "pnpm exec tauri dev",
    "desktop:build": "pnpm exec tauri build",
    "android:sync": "pnpm manus:build-source && pnpm exec cap sync android",
    "android:open": "pnpm exec cap open android",
    "android:build:debug": "pnpm android:sync && node scripts/native/android-build.mjs assembleDebug",
    "android:build:release": "pnpm android:sync && node scripts/native/android-build.mjs bundleRelease"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.18.0"
}
